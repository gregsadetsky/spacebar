{
  "id": "markdown",
  "name": "Markdown",
  "version": "0.1.0",
  "matches": {
    "extensions": [
      "md",
      "markdown",
      "mdown",
      "mkd"
    ],
    "utis": [
      "net.daringfireball.markdown"
    ]
  },
  "input": "text",
  "maxFileSize": 10485760,
  "entry": "index.html",
  "requiresHost": "0.2.0"
}
